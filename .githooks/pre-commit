#!/bin/bash
# Local pre-commit hook for iCollegamenti
# Prevents accidental commit of secrets, forbidden files, and unredacted paths.

set -e

echo "🔍 Running pre-commit security and hygiene checks..."

# 1. Check for forbidden file names
FORBIDDEN=$(git diff --cached --name-only | grep -E '(\.DS_Store|\.env|\.pem$|\.p12$|\.key$|\.dmg$|\.app/)' || true)
if [ -n "$FORBIDDEN" ]; then
    echo "❌ ERROR: Attempting to commit forbidden or sensitive files:"
    echo "$FORBIDDEN"
    echo "Please remove these files from staging before committing."
    exit 1
fi

# 2. Check for large files (> 10MB)
LARGE_FILES=0
for FILE in $(git diff --cached --name-only); do
    if [ -f "$FILE" ]; then
        SIZE=$(stat -f%z "$FILE" 2>/dev/null || stat -c%s "$FILE" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt 10485760 ]; then
            echo "❌ ERROR: File $FILE is larger than 10MB ($(($SIZE / 1048576)) MB)."
            echo "Large binary files should not be committed to git."
            LARGE_FILES=1
        fi
    fi
done
if [ "$LARGE_FILES" -eq 1 ]; then
    exit 1
fi

# 3. Check for secrets/tokens in staged changes
SECRETS_FOUND=0
STAGED_DIFF=$(git diff --cached)

if echo "$STAGED_DIFF" | grep -qE "-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----"; then
    echo "❌ ERROR: Detected Private Key in staged changes!"
    SECRETS_FOUND=1
fi

if echo "$STAGED_DIFF" | grep -qE "gh[pousr]_[A-Za-z0-9_]{36,}"; then
    echo "❌ ERROR: Detected GitHub Personal Access Token in staged changes!"
    SECRETS_FOUND=1
fi

AWS_KEY_REGEX="(A3T[A-Z0-9]|A""KIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}"
if echo "$STAGED_DIFF" | grep -qE "$AWS_KEY_REGEX"; then
    echo "❌ ERROR: Detected Cloud Access Key in staged changes!"
    SECRETS_FOUND=1
fi

if [ "$SECRETS_FOUND" -eq 1 ]; then
    echo "Commit aborted to protect repository security."
    exit 1
fi

echo "✅ All pre-commit checks passed successfully."
exit 0
